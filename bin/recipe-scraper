#!/usr/bin/env sh
# Finds a Python 3.11+ (skipping stubs such as the Windows Store "python3" alias) and runs the launcher.
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
for py in python3 python py; do
    if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' >/dev/null 2>&1; then
        exec "$py" "$ROOT/scripts/launch.py" "$@"
    fi
done
echo "recipe-scraper: Python 3.11 or newer is required (https://www.python.org/downloads/)" >&2
exit 1
